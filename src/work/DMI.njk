{% endblock %}

{% block main %}

    <div class="for-u-page">
      <div class="for-u-container">

        <!-- Project Header -->
        <header class="project-header">
          <div class="project-title-area">
            <h1>DMI Website</h1>
            <p class="subtitle">{% if zh %}Harry 主導了 MassArt Dynamic Media Institute 網站的全面升級與品牌再設計。這個專案涵蓋網站架構重組、視覺識別更新，以及學術論文內容的整合管理，顯著提升了網站的載入速度與使用者參與度。{% else %}
              Harry led the comprehensive upgrade and rebranding of the MassArt Dynamic Media Institute website. This
              project encompassed website architecture restructuring, visual identity renewal, and management of
              academic thesis content integration, significantly improving load times and user engagement.
            {% endif %}</p>
          </div>

          <!-- Metadata -->
          <div class="project-meta-table">
            <div class="meta-row">
              <span class="meta-label">{% if zh %}類別{% else %}Category{% endif %}</span>
              <span class="meta-value">{% if zh %}網頁設計 / 品牌識別{% else %}Web Design / Branding{% endif %}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{% if zh %}角色{% else %}Role{% endif %}</span>
              <span class="meta-value">{% if zh %}網頁設計師 / 品牌設計師{% else %}Web Designer / Brand Designer{% endif %}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{% if zh %}年份{% else %}Date{% endif %}</span>
              <span class="meta-value">2022 – 2024</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{% if zh %}機構{% else %}Institution{% endif %}</span>
              <span class="meta-value">MassArt DMI</span>
            </div>
          </div>
        </header>

        <!-- Hero Image — Macbook Mockup -->
        <section class="media-block full-width">
          <div class="image-wrapper">
            <img src="/images/Project/DMI/DMI_Macbook%20Pro%20Mockup.webp" alt="DMI Website Macbook Mockup" loading="eager">
          </div>
        </section>

        <!-- Institute Website Upgrade -->
        <section class="content-grid-2col">
          <div class="text-section">
            <span class="section-kicker">{% if zh %}總覽{% else %}Overview{% endif %}</span>
            <h3>{% if zh %}機構網站升級{% else %}Institute Website Upgrade{% endif %}</h3>
            <p>{% if zh %}Harry 在 MassArt DMI 期間，全面優化了學院動態媒體研究所的網站架構表現。透過精簡圖片資料與管理複雜的論文內容，大幅提升了網站載入速度與學術社群的使用者參與度。同時，Harry 也主導了品牌再設計，讓 DMI 在視覺上煥然一新。{% else %}
              During his time at MassArt DMI, Harry optimized the architectural performance of the Dynamic Media
              Institute's web platforms. By streamlining image data and managing complex thesis content, he
              significantly improved load times and user engagement within the academic community. Harry also led the
              rebranding initiative that gave DMI a fresh new visual identity.
            {% endif %}</p>
            <ul class="dmi-role-list">
              <li>{% if zh %}網站架構優化{% else %}Website Architecture Optimization{% endif %}</li>
              <li>{% if zh %}品牌識別再設計{% else %}Brand Identity Redesign{% endif %}</li>
              <li>{% if zh %}論文內容整合管理{% else %}Thesis Content Management{% endif %}</li>
            </ul>
          </div>
          <div class="media-block media-block--flush">
            <div class="image-wrapper image-wrapper--transparent">
              <img src="/images/Project/DMI/DMI_Website.webp" alt="DMI Website" loading="lazy" class="img--contained-tall">
            </div>
          </div>
        </section>

        <!-- Tools & Software -->
        <section class="content-grid-2col">
          <div class="media-block media-block--flush media-block--video">
            <video autoplay="" muted="" loop="" playsinline="" controls="" class="block-video">
              <source src="/images/Project/DMI/DMI%20VIDEO.mp4" type="video/mp4">
            </video>
          </div>
          <div class="text-section">
            <span class="section-kicker">{% if zh %}工具{% else %}Tools{% endif %}</span>
            <h3>{% if zh %}工具與軟體{% else %}Tools &amp; Software{% endif %}</h3>
            <p>{% if zh %}Harry 使用 Figma 進行網站的 UI 設計與原型製作，透過 WordPress 系統進行內容管理，並使用 Adobe Creative Suite 進行品牌視覺的設計與製作。整個工作流程涵蓋了從設計策略到最終開發交付的完整鏈路。{% else %}
              Harry used Figma for UI design and prototyping, WordPress for content management, and Adobe Creative
              Suite for brand visual design. The workflow covered the complete chain from design strategy to final
              development handoff.
            {% endif %}</p>
            <ul class="dmi-role-list">
              <li>{% if zh %}Figma — UI 設計與原型{% else %}Figma — UI Design &amp; Prototype{% endif %}</li>
              <li>{% if zh %}WordPress — 內容管理系統{% else %}WordPress — CMS{% endif %}</li>
              <li>Adobe Photoshop / Illustrator</li>
            </ul>
          </div>
        </section>

        <!-- Before / After Quote -->
        <div class="dmi-quote-banner">
          <h2>{% if zh %}*品牌再造後，DMI 網站煥然一新*{% else %}*With Rebranding, DMI Website Looks Updated*{% endif %}</h2>
        </div>

        <!-- Logo Ideations -->
        <div class="dmi-logo-grid">
          <div class="image-wrapper">
            <img src="/images/Project/DMI/Logo%20Ideation-16.png" alt="DMI Original Logo Concept" loading="lazy">
          </div>
          <div class="image-wrapper">
            <img src="/images/Project/DMI/Logo%20Ideation-17.png" alt="DMI Logo Iteration" loading="lazy">
          </div>
          <div class="image-wrapper">
            <img src="/images/Project/DMI/Logo%20Ideation-18.png" alt="DMI Redesigned Logo" loading="lazy">
          </div>
          <div class="image-wrapper">
            <img src="/images/Project/DMI/Logo%20Ideation-19.png" alt="DMI Logo Final 1" loading="lazy">
          </div>
          <div class="image-wrapper">
            <img src="/images/Project/DMI/Logo%20Ideation-20.png" alt="DMI Logo Final 2" loading="lazy">
          </div>
        </div>

        <!-- Full Redesign Screenshot -->
        <section class="media-block full-width">
          <div class="image-wrapper">
            <img src="/images/Project/DMI/DMI_Redesign-1.webp" alt="DMI Website Full Redesign" loading="lazy">
          </div>
        </section>



        <!-- Graduate Photo -->
        <section class="media-block full-width">
          <div class="image-wrapper">
            <img src="/images/Project/DMI/DMI_graduate.webp" alt="DMI MassArt Graduation" loading="lazy">
          </div>
        </section>

        <!-- DMI Posters -->
        <section class="media-block full-width">
          <div class="image-wrapper">
            <img src="/images/Project/DMI/Glued-Posters-Mockup.jpg" alt="DMI Posters" loading="lazy">
          </div>
        </section>

        <!-- Footer CTA -->
        <section class="learn-more-section learn-more-section--spaced">
          <div class="learn-more-inner">
            <h2 class="learn-more-title">{% if zh %}期待很快與您對話！{% else %}Looking Forward To Speaking With You Soon!{% endif %}</h2>
            {% if zh %}<a href="{{ L }}/work" data-spa-target="work" class="learn-more-btn">{% else %}<a href="{{ L }}/work/" data-spa-target="work" class="learn-more-btn">{% endif %}
              <span>{% if zh %}查看更多作品{% else %}See more work{% endif %}</span>
              <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </section>

      </div>
    </div>
{% endblock %}
