{% block main %}

    <div class="for-u-page">
      <div class="for-u-container">

        <!-- Project Header -->
        <header class="project-header">
          <div class="project-title-area">
            <h1>ARCCSRL</h1>
            <p class="subtitle">{% if zh %}Harry 在 MIT Media Lab 的課程中探索人機互動科技，參與了 ARCCSRL 連續機械肢體研究專案。在此專案中同時負責視覺傳達圖片產出、協助搭建 HoloLens 的視覺輔助 GUI，以及最終的發表報告設計。透過多媒體設計的專業，設計出實驗時所需的圖表以及最終報告的簡報，研究成果最終在哈佛創新實驗室與 MIT Media Lab 公開展出。{% else %}
              Harry explored human-computer interaction technologies through MIT Media Lab's course, contributing
              to the ARCCSRL continuous robotic limb research project. He was responsible for visual
              communication assets, assisting in building the HoloLens AR GUI, and designing the final
              presentation report. The research outcomes were exhibited at Harvard Innovation Labs and MIT Media Lab.
            {% endif %}</p>
          </div>

          <!-- Metadata -->
          <div class="project-meta-table">
            <div class="meta-row">
              <span class="meta-label">{% if zh %}類別{% else %}Category{% endif %}</span>
              <span class="meta-value">{% if zh %}人機互動研究{% else %}Human-Computer Interaction{% endif %}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{% if zh %}角色{% else %}Role{% endif %}</span>
              <span class="meta-value">{% if zh %}UX 研究員 / GUI 設計師{% else %}UX Researcher / GUI Designer{% endif %}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{% if zh %}年份{% else %}Date{% endif %}</span>
              <span class="meta-value">2023 – 2024</span>
