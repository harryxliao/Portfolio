{% block main %}
    

    {% if zh %}<link rel="stylesheet" href="/assets/css/project-detail.css">

{% else %}{% endif %}<div class="for-u-page">
      <div class="for-u-container">

        <!-- Project Header -->
        <header class="project-header">
          <div class="project-title-area">
            <h1>For-U: M/V</h1>
            <p class="subtitle">{% if zh %}「For-U」是一首由 RNGDN 創作，並與新生代女歌手 Luna 共同演出的浩室音樂單曲。故事講述了一位年輕女孩的內心世界，希望能為聽眾帶來一部充滿動感的音樂作品。{% else %}
              "For-U" is a house music single created by RNGDN and co-performed with the new female singer Luna. The
              story tells the inner world of a young girl, hoping to bring listeners a dynamic musical work.
            {% endif %}</p>
          </div>

          <!-- Metadata -->
          <div class="project-meta-table">
            <div class="meta-row">
              <span class="meta-label">{% if zh %}類別{% else %}Category{% endif %}</span>
              <span class="meta-value">{% if zh %}音樂錄影帶{% else %}Music Video{% endif %}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{% if zh %}角色{% else %}Role{% endif %}</span>
              <span class="meta-value">{% if zh %}音樂製作人{% else %}Music Producer{% endif %}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{% if zh %}年份{% else %}Date{% endif %}</span>
              <span class="meta-value">{% if zh %}2024{% else %}2019{% endif %}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{% if zh %}公司{% else %}Company{% endif %}</span>
              <span class="meta-value">{% if zh %}兄弟會音樂 Brotherhood Casual{% else %}Brotherhood Casual{% endif %}</span>
            </div>
          </div>
        </header>

        <!-- Hero Video -->
        <section class="media-block full-width">
          <div class="iframe-wrapper">
            <iframe src="https://player.vimeo.com/video/1205695343?autoplay=1&amp;loop=1&amp;muted=1&amp;controls=1&amp;title=0&amp;byline=0&amp;portrait=0" title="Vimeo video player" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write" allowfullscreen=""></iframe>
          </div>
          <div class="block-caption" style="justify-content: center; text-align: center;">
            <span class="video-title--subtle">{% if zh %}(影片標題：Reno Gordon / 為你 For - U (Feat. Luna) Official Music Video){% else %}
              (Video Title: Reno Gordon / 為你 For - U (Feat. Luna) Official Music Video)
            {% endif %}</span>
          </div>
        </section>

        <!-- About This Project -->
        <section class="content-grid-2col">
          <div class="text-section">
            <span class="section-kicker">{% if zh %}總覽{% else %}Overview{% endif %}</span>
            <h3>{% if zh %}關於此專案{% else %}About This Project{% endif %}</h3>
            <p>{% if zh %}這是一部完全基於虛擬場景創作的音樂作品，充滿未來元素並結合 3D 動畫。{% else %}
              This is a music completely created based on a virtual set, which is full of futuristic elements and
              combined with 3D animation.
            {% endif %}</p>
            <div class="project-tags">
              <span class="tag">🎵 Music Videos</span>
              <span class="tag">💡 Art Direction</span>
              <span class="tag">🌐 3D Modeling</span>
            </div>
          </div>
          <div class="media-block media-block--flush">
            <div class="image-wrapper">
              <img src="/images/Project/for_u_04.webp" alt="For-U Scene" loading="lazy">
            </div>
          </div>
        </section>

        <!-- Thanks To My Team -->
        <section class="content-grid-2col content-grid-2col--stretch">
          <div class="media-block media-block--flush">
            <div class="image-wrapper">
              <img src="/images/Project/For-U_cover.webp" alt="For-U Cover" loading="lazy">
            </div>
          </div>
          <div class="text-section">
            <span class="section-kicker">{% if zh %}團隊{% else %}Team{% endif %}</span>
            <h3>{% if zh %}感謝我的團隊{% else %}Thanks To My Team{% endif %}</h3>
            <ul class="thanks-team-list credits-list">
              <li>
                <strong>-Video Credit-</strong>
                <span>{% if zh %}企劃統籌：Reno Gordon 里諾戈登{% else %}Planner: Reno Gordon{% endif %}</span>
                <span>{% if zh %}創意統籌：楊博智 Po Zhi Yang{% else %}Creative Director: Po Zhi Yang{% endif %}</span>
                <span>{% if zh %}導演/編劇：RNGDN 里諾戈登{% else %}Director/Writer: RNGDN{% endif %}</span>
              </li>
              <li>
                <strong>-Brotherhood Casual-</strong>
                <span>{% if zh %}專輯製作&amp;藝人經紀整合工作室：兄弟會音樂 Brotherhood Casual{% else %}Production &amp;
                  Management Studio: Brotherhood Casual{% endif %}</span>
                <span>{% if zh %}經紀人：鄢天佑{% else %}Manager: Tian-You Yan{% endif %}</span>
              </li>
              <li>
                <strong>-Song Credit-</strong>
                <span>{% if zh %}製作人 Producer：Reno Gordon 里諾戈登{% else %}Producer: Reno Gordon{% endif %}</span>
                <span>{% if zh %}編曲 Arranger：RNGDN 里諾戈登{% else %}Arranger: RNGDN{% endif %}</span>
                <span>{% if zh %}和聲編寫 Backing Vocal Arranger：謝遜 Xun Xie{% else %}Backing Vocal
                  Arranger: Xun Xie{% endif %}</span>
                <span>{% if zh %}錄音工程師 Recording Engineer：謝遜 Xun Xie{% else %}Recording Engineer: Xun
                  Xie{% endif %}</span>
                <span>{% if zh %}錄音工作室 Recording Studio：金音俱樂部錄音室 Gold Sound Club Studio{% else %}Recording Studio: Gold Sound Club Studio{% endif %}</span>
                <span>{% if zh %}母帶工程師 Mastering Engineer：Austin Leeds{% else %}Mastering Engineer:
                  Austin Leeds{% endif %}</span>
              </li>

            </ul>
          </div>
        </section>

        <!-- Branding Design -->
        <section class="section-header section-header--mt-lg">
          <h2>{% if zh %}「音樂影片設計」{% else %}"Music Video Design"{% endif %}</h2>
          <p class="section-header-desc">{% if zh %}影片設計的靈感來自宇宙、探索與未來的主題。藉由深藍色與銀色作為主色調，傳達出高科技與神祕的感覺。透過 3D 模型與光影的變化，創造了獨特的視覺風格。{% else %}
            The video design is inspired by the themes of the universe, exploration, and the future. By using deep blue
            and silver as the main colors, it conveys a high-tech and mysterious feel. A unique visual style is created
            through 3D models and light and shadow changes.
          {% endif %}</p>
        </section>

        <section class="media-block full-width">
          <div class="image-wrapper">
            <img src="/images/Project/for_u_05.webp" alt="For-U Typography Design" loading="lazy">
          </div>
        </section>

        <section class="media-block full-width">
          <div class="image-wrapper">
            <img src="/images/Project/for_u_03.webp" alt="For-U Landscape Render" loading="lazy">
          </div>
        </section>

        <section class="media-block full-width">
          <div class="image-wrapper">
            <img src="/images/Project/for_u_01.webp" alt="For-U Detail 1" loading="lazy">
          </div>
        </section>

        <section class="media-block full-width">
          <div class="image-wrapper">
            <img src="/images/Project/for_u_02.webp" alt="For-U Detail 2" loading="lazy">
          </div>
        </section>

        <section class="media-block full-width">
          <div class="image-wrapper">
            <img src="/images/Project/For-U_Harry.webp" alt="Working Photo of Harry" loading="lazy">
          </div>
        </section>

        <!-- Footer CTA -->
        <section class="learn-more-section learn-more-section--spaced">
          <div class="learn-more-inner">
            <h2 class="learn-more-title">{% if zh %}期待很快與您對話！{% else %}Looking Forward To Speaking With You Soon!{% endif %}</h2>
            {% if zh %}<a href="{{ L }}/work" data-spa-target="work" class="learn-more-btn">{% else %}<a href="{{ L }}/work/" data-spa-target="work" class="learn-more-btn">{% endif %}
              <span>{% if zh %}查看更多作品{% else %}See more work{% endif %}</span>
              <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </section>

      </div>
    </div>
{% endblock %}
