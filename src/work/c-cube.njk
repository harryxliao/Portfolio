{% block tail %}
<div id="ccubeLightbox" style="
  display:none; position:fixed; inset:0; z-index:9999;
  background:rgba(0,0,0,0.92); backdrop-filter:blur(8px);
  align-items:center; justify-content:center; cursor:zoom-out;
  overflow:hidden; touch-action:none;
">
  <div id="ccubeLightboxContainer" style="
    position:relative; width:100%; height:100%;
    display:flex; align-items:center; justify-content:center;
  ">
    <img id="ccubeLightboxImg" src="" alt="Enlarged view" style="
      max-width:95vw; max-height:95vh; object-fit:contain;
      box-shadow:0 24px 80px rgba(0,0,0,0.7);
      transition:none; transform-origin:center;
      cursor:zoom-in; user-select:none; -webkit-user-drag:none;
    ">
  </div>
  <button style="
    position:absolute; top:20px; right:28px; z-index:10000;
    background:rgba(0,0,0,0.5); border:1px solid rgba(255,255,255,0.3); color:#fff;
    font-size:20px; width:44px; height:44px; border-radius:50%;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    transition:background 0.2s;
  " aria-label="Close">✕</button>
</div>

<script>
(function(){
  var triggers = document.querySelectorAll('.c-cube-lightbox-trigger');
  var lightbox = document.getElementById('ccubeLightbox');
  var lightboxImg = document.getElementById('ccubeLightboxImg');
  
  var scale = 1;
  var pointX = 0;
  var pointY = 0;
  var start = { x: 0, y: 0 };
  var isPanning = false;
  var panned = false;

  function updateTransform() {
    lightboxImg.style.transform = "translate(" + pointX + "px, " + pointY + "px) scale(" + scale + ")";
  }

  function resetZoom() {
    scale = 1;
    pointX = 0;
    pointY = 0;
    updateTransform();
    lightboxImg.style.cursor = "zoom-in";
  }

  triggers.forEach(function(img) {
    img.addEventListener('click', function(e) {
      e.stopPropagation();
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightbox.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      resetZoom();
    });
  });

  lightbox.addEventListener('click', function(e) {
    if ((e.target === lightbox || e.target === document.getElementById('ccubeLightboxContainer')) && !panned) {
      lightbox.style.display = 'none';
      document.body.style.overflow = '';
    }
  });

  var closeBtn = lightbox.querySelector('button');
  if (closeBtn) {
    closeBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      lightbox.style.display = 'none';
      document.body.style.overflow = '';
    });
  }

  lightbox.addEventListener('wheel', function(e) {
    e.preventDefault();
    var xs = (e.clientX - lightbox.clientWidth / 2 - pointX) / scale;
    var ys = (e.clientY - lightbox.clientHeight / 2 - pointY) / scale;
    var delta = (e.deltaY < 0) ? 1.25 : 0.8;
    var tempScale = scale * delta;
    
    if (tempScale >= 1 && tempScale <= 8) {
      scale = tempScale;
      pointX = (e.clientX - lightbox.clientWidth / 2) - xs * scale;
      pointY = (e.clientY - lightbox.clientHeight / 2) - ys * scale;
      updateTransform();
    } else if (tempScale < 1) {
      resetZoom();
    }
    
    if (scale > 1) {
      lightboxImg.style.cursor = "grab";
    } else {
      lightboxImg.style.cursor = "zoom-in";
    }
  }, { passive: false });

  lightboxImg.addEventListener('dblclick', function(e) {
    e.stopPropagation();
    if (scale > 1) {
      resetZoom();
    } else {
      scale = 3;
      var clientRect = lightbox.getBoundingClientRect();
      pointX = (e.clientX - clientRect.left - clientRect.width / 2) * (1 - scale);
      pointY = (e.clientY - clientRect.top - clientRect.height / 2) * (1 - scale);
      updateTransform();
      lightboxImg.style.cursor = "grab";
    }
  });

  lightboxImg.addEventListener('mousedown', function(e) {
    e.stopPropagation();
    e.preventDefault();
    isPanning = true;
    panned = false;
    start = { x: e.clientX - pointX, y: e.clientY - pointY };
    if (scale > 1) {
      lightboxImg.style.cursor = "grabbing";
    }
  });

  document.addEventListener('mousemove', function(e) {
    if (!isPanning) return;
    panned = true;
    pointX = e.clientX - start.x;
    pointY = e.clientY - start.y;
    updateTransform();
  });

  document.addEventListener('mouseup', function(e) {
    if (!isPanning) return;
    isPanning = false;
    if (scale > 1) {
      lightboxImg.style.cursor = "grab";
    } else {
      lightboxImg.style.cursor = "zoom-in";
    }
    setTimeout(function() {
      panned = false;
    }, 50);
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && lightbox.style.display === 'flex') {
      lightbox.style.display = 'none';
      document.body.style.overflow = '';
    }
  });

  // Touch Support
  var lastTouchDist = 0;
  var tp = false;
  lightbox.addEventListener('touchstart', function(e) {
    if (e.touches.length === 1) {
      isPanning = true;
      panned = false;
      var t = e.touches[0];
      start = { x: t.clientX - pointX, y: t.clientY - pointY };
    } else if (e.touches.length === 2) {
      lastTouchDist = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY
      );
      tp = true;
    }
  });

  lightbox.addEventListener('touchmove', function(e) {
    if (isPanning && e.touches.length === 1) {
      e.preventDefault();
      panned = true;
      var t = e.touches[0];
      pointX = t.clientX - start.x;
      pointY = t.clientY - start.y;
      updateTransform();
    } else if (e.touches.length === 2 && tp) {
      e.preventDefault();
      var dist = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY
      );
      var factor = dist / lastTouchDist;
      var tempScale = scale * factor;
      if (tempScale >= 1 && tempScale <= 8) {
        scale = tempScale;
        updateTransform();
      }
      lastTouchDist = dist;
    }
  }, { passive: false });

  lightbox.addEventListener('touchend', function(e) {
    isPanning = false;
    tp = false;
  });
})();
</script>
{% endblock %}
