{% block main %}

    <div class="for-u-page">
      <div class="for-u-container">

        <!-- Project Header -->
        <header class="project-header">
          <div class="project-title-area">
            <h1>ABC Design</h1>
            <p class="subtitle">{% if zh %}ABC Design 是一家位於台中的品牌設計公司，專注於嬰兒推車品牌的視覺識別與行銷設計。Harry 在此擔任核心平面設計師，負責品牌視覺策略、圖形設計系統，以及社群短影片的製作與執行。{% else %}
              ABC Design is a brand design company based in Taichung, specializing in visual identity and marketing
              design for stroller brands. Harry served as a core graphic designer, responsible for brand visual
              strategy, graphic design systems, and the production of social media short videos.
            {% endif %}</p>
          </div>

          <!-- Metadata -->
          <div class="project-meta-table">
            <div class="meta-row">
              <span class="meta-label">{% if zh %}類別{% else %}Category{% endif %}</span>
              <span class="meta-value">{% if zh %}品牌設計 / 平面設計{% else %}Brand / Graphic Design{% endif %}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{% if zh %}角色{% else %}Role{% endif %}</span>
              <span class="meta-value">{% if zh %}平面設計師{% else %}Graphic Designer{% endif %}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{% if zh %}年份{% else %}Date{% endif %}</span>
              <span class="meta-value">2021 – 2022</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{% if zh %}公司{% else %}Company{% endif %}</span>
              <span class="meta-value">ABC Design</span>
            </div>
          </div>
        </header>

        <!-- Hero Image — Banner -->
        <section class="media-block full-width abc-wide-image">
          <div class="image-wrapper">
            <img src="/images/Project/ABC%20Design/ABC%20Design%20Banner%20(1).webp" alt="ABC Design Banner" loading="eager">
          </div>
        </section>

        <!-- About ABC Design -->
        <section class="content-grid-2col">
          <div class="text-section">
            <span class="section-kicker">{% if zh %}總覽{% else %}Overview{% endif %}</span>
            <h3>{% if zh %}關於 ABC Design{% else %}About ABC Design{% endif %}</h3>
            <p>{% if zh %}ABC Design 是一個充滿活力的設計工作室，服務多個嬰兒推車品牌，包含 AVUS、Vida、Zephair 等。Harry 負責統籌品牌識別設計、產品視覺規劃，並針對社群媒體製作大量短影音內容，協助品牌在市場上建立鮮明形象。{% else %}
              ABC Design is a dynamic design studio serving multiple stroller brands, including AVUS, Vida, and Zephair.
              Harry oversaw brand identity design, product visual planning, and produced extensive short-video content
              for social media, helping brands establish a strong market presence.
            {% endif %}</p>
            <ul class="abc-role-list">
              <li>{% if zh %}品牌識別設計{% else %}Brand Identity Design{% endif %}</li>
              <li>{% if zh %}社群短影音製作{% else %}Social Media Short Video Production{% endif %}</li>
              <li>{% if zh %}平面視覺設計系統{% else %}Graphic Visual Design System{% endif %}</li>
            </ul>
            <div class="abc-links-row">
              <a href="https://www.instagram.com/abcdesign.tw/" target="_blank" rel="noopener noreferrer" class="abc-link">
                <span>IG</span> <span>ABC Design</span>
              </a>
            </div>
          </div>
          <div class="media-block media-block--flush abc-intro-logo">
            <div class="image-wrapper">
              <img src="/images/Project/ABC%20Design/ABC%20Design.webp" alt="ABC Design Logo" loading="lazy">
            </div>
          </div>
        </section>

        <!-- Trade Show / Exhibition -->
        <section class="content-grid-2col">
          <div class="media-block media-block--flush">
            <div class="image-wrapper">
              <img src="/images/Project/ABC%20Design/ABC%20Design%20Banner%20(2).webp" alt="ABC Design Exhibition Booth" loading="lazy">
            </div>
          </div>
          <div class="text-section">
            <span class="section-kicker">{% if zh %}工作內容{% else %}Responsibilities{% endif %}</span>
            <h3>{% if zh %}身為平面設計師{% else %}Being A Graphic Designer{% endif %}</h3>
            <p>{% if zh %}Harry 在 ABC Design 期間，深度參與品牌視覺系統的建立，從展覽攤位設計、產品型錄到社群媒體視覺，每一個接觸點都需要保持高度一致性。此外，Harry 也負責拍攝與剪輯多款品牌短影片，透過動態視覺說故事，強化品牌在消費者心中的形象。{% else %}
              During his time at ABC Design, Harry was deeply involved in building the brand visual system — from
              exhibition booth design and product catalogs to social media visuals, maintaining high consistency
              across every touchpoint. Harry also directed and edited multiple brand short videos, using dynamic
              visuals to tell stories that reinforced the brand's image in consumers' minds.
            {% endif %}</p>
            <ul class="abc-role-list">
              <li>{% if zh %}展覽視覺設計{% else %}Exhibition Visual Design{% endif %}</li>
              <li>{% if zh %}產品攝影指導{% else %}Art Direction &amp; Photography{% endif %}</li>
              <li>{% if zh %}影音剪輯與製作{% else %}Video Editing &amp; Production{% endif %}</li>
            </ul>
          </div>
        </section>

        <!-- Short Videos Section Header -->
        <section class="section-header section-header--mt-md">
          <h2>{% if zh %}「短影音作品」{% else %}"Short Videos"{% endif %}</h2>
          <p class="section-header-desc">{% if zh %}以下是 Harry 為 ABC Design 旗下品牌製作的社群短影音，分別用於 Instagram Reels 及各社群平台推廣。{% else %}
            Short-form video content produced for ABC Design's brands, created for Instagram Reels and social media
            promotion across multiple platforms.
          {% endif %}</p>
        </section>

        <!-- Short Videos Grid -->
        <div class="abc-video-grid">
          <div class="abc-video-item">
            <div class="abc-video-label">AVUS</div>
            <video autoplay="" muted="" loop="" playsinline="">
              <source src="/images/Project/ABC%20Design/AVUS_Shorts.mp4" type="video/mp4">
            </video>
          </div>
          <div class="abc-video-item">
            <div class="abc-video-label">Vida</div>
            <video autoplay="" muted="" loop="" playsinline="">
              <source src="/images/Project/ABC%20Design/Vida_Shorts.mp4" type="video/mp4">
            </video>
