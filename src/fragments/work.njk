---
slug: "fragments/work.html"
layout: null
eleventyExcludeFromCollections: true
---
<link rel="stylesheet" href="/assets/css/work.css">
<div class="work-page">
  <div class="work-container">


    <section class="work-featured" aria-label="Featured work">
      <a class="work-featured-card work-link" href="{{ L }}/work/gate-mg.html" data-spa-target="work/gate-mg" aria-label="Gate.com Motion Graphics">
        <video class="work-video" autoplay="" loop="" muted="" playsinline="" data-fallback="/images/Gate.webp" poster="/images/Gate.webp" aria-label="Gate.com Motion Graphics">
          <source src="/videos/Gate%20Music%20Festival.mp4" type="video/mp4">
        </video>
        <div class="work-overlay">
          <span class="work-index">01</span>
          <h2>{% if zh %}Gate.com 動態設計{% else %}Gate.com Motion Graphics{% endif %}</h2>
          <p>{% if zh %}動態設計{% else %}Motion Graphics{% endif %}</p>
        </div>
      </a>
    </section>

    <section class="work-grid" aria-label="Selected work">
      <a class="work-card work-card--wide work-link" href="{{ L }}/work/gate-redbull.html" data-spa-target="work/gate-redbull" aria-label="Gate X RedBull Racing F1 NFT Page">
        <img src="/images/Work/Gate%20X%20RedBull%20Racing%20F1%20NFT%20Page.webp" alt="Gate X RedBull Racing F1 NFT Page">
        <div class="work-overlay">
          <span class="work-index">02</span>
          <h2>{% if zh %}Gate X RedBull Racing F1 NFT 頁面{% else %}Gate X RedBull Racing F1 NFT Page{% endif %}</h2>
          <p>{% if zh %}Web3 / 活動{% else %}Web3 / Campaign{% endif %}</p>
        </div>
      </a>

      <a class="work-card work-card--wide work-link" href="{{ L }}/work/cocook-app.html" data-spa-target="work/cocook-app" aria-label="Cocook App Design">
        <video autoplay="" loop="" muted="" playsinline="" data-fallback="/images/Work/Cocook%20App%20Design.webp" poster="/images/Work/Cocook%20App%20Design.webp" aria-label="Cocook App Design">
          <source src="/videos/Cocooks-demo.mp4" type="video/mp4">
        </video>
        <div class="work-overlay">
          <span class="work-index">03</span>
          <h2>{% if zh %}Cocook App 設計{% else %}Cocook App Design{% endif %}</h2>
          <p>{% if zh %}App 設計{% else %}App Design{% endif %}</p>
        </div>
      </a>

      <a class="work-card work-card--third work-link" href="{{ L }}/work/thesisbook.html" data-spa-target="work/thesisbook" aria-label="MFA Thesis Book Dream Reality">
        <img src="/images/Work/MFA%20Thesis%20Book%20%20Dream%20Reality.webp" alt="MFA Thesis Book Dream Reality">
        <div class="work-overlay">
          <span class="work-index">04</span>
          <h2>{% if zh %}Dream Reality 碩論書{% else %}MFA Thesis Book : Dream Reality{% endif %}</h2>
          <p>{% if zh %}出版 / 論文{% else %}Publication / Thesis{% endif %}</p>
        </div>
      </a>

      <a class="work-card work-card--third work-link" href="{{ L }}/work/bjs-intern.html" data-spa-target="work/bjs-intern" aria-label="BJs Wholesale Club Summer Internship Design">
        <video autoplay="" loop="" muted="" playsinline="" data-fallback="/images/Work/BJ's%20Wholesale%20Club%20Summer%20Internship%20Design.webp" poster="/images/Work/BJ's%20Wholesale%20Club%20Summer%20Internship%20Design.webp" aria-label="BJs Wholesale Club Summer Internship Design">
          <source src="/videos/BJs%20Wholesale%20Club%20Internship%20Final%20Showreel.mp4" type="video/mp4">
        </video>
        <div class="work-overlay">
          <span class="work-index">05</span>
          <h2>{% if zh %}BJ's 暑期實習設計{% else %}BJ's Wholesale Club Summer Internship Design{% endif %}</h2>
          <p>{% if zh %}實習 / 品牌{% else %}Internship / Brand{% endif %}</p>
        </div>
      </a>

      <a class="work-card work-card--third work-link" href="{{ L }}/work/for-u.html" data-spa-target="work/for-u" aria-label="Reno Gordon For-U Music Video">
        <video autoplay="" loop="" muted="" playsinline="" data-fallback="/images/Work/For-U_cover.webp" poster="/images/Work/For-U_cover.webp" aria-label="Reno Gordon For-U Music Video">
          <source src="/videos/Reno_Gordon_For-U_S.mp4" type="video/mp4">
        </video>
        <div class="work-overlay">
          <span class="work-index">06</span>
          <h2>{% if zh %}For-U 音樂影像{% else %}Reno Gordon - "For-U" M/V{% endif %}</h2>
          <p>{% if zh %}動態 / MV{% else %}Motion / Music Video{% endif %}</p>
        </div>
      </a>

      <a class="work-card work-card--third work-link" href="{{ L }}/work/DMI.html" data-spa-target="work/DMI" aria-label="DMI Website Redesign">
        <img src="/images/Work/DMI%20Website%20Redesign.webp" alt="DMI Website Redesign">
        <div class="work-overlay">
          <span class="work-index">07</span>
          <h2>{% if zh %}DMI 網站重新設計{% else %}DMI Website Redesign{% endif %}</h2>
          <p>{% if zh %}網站重新設計{% else %}Website Redesign{% endif %}</p>
        </div>
      </a>

      <a class="work-card work-card--third work-link" href="{{ L }}/work/ABC-Design.html" data-spa-target="work/ABC-Design" aria-label="ABC DESIGN Social Media Visual">
        <img src="/images/Work/ABC%20DESIGN%20%20Social%20Media%20Visual.webp" alt="ABC DESIGN Social Media Visual">
        <div class="work-overlay">
          <span class="work-index">08</span>
          <h2>{% if zh %}ABC DESIGN 社群視覺{% else %}ABC DESIGN | Social Media Visual{% endif %}</h2>
          <p>{% if zh %}社群視覺{% else %}Social Visual{% endif %}</p>
        </div>
      </a>

      <a class="work-card work-card--third work-link" href="{{ L }}/work/ARCCSRL-Robotic-Limb.html" data-spa-target="work/ARCCSRL-Robotic-Limb" aria-label="MIT ARCCSRL Robotic Limb Project">
        <img src="/images/Work/ARCCSRL.webp" alt="MIT ARCCSRL Robotic Limb Project">
        <div class="work-overlay">
          <span class="work-index">09</span>
          <h2>{% if zh %}MIT ARCCSRL 義肢研究{% else %}MIT ARCCSRL Robotic Limb Project{% endif %}</h2>
          <p>{% if zh %}研究 / 機器人{% else %}Research / Robotics{% endif %}</p>
        </div>
      </a>
    </section>

    <section class="work-index-section" aria-label="Full index of work">
      <div class="work-index-head">
        <p class="work-kicker">{% if zh %}索引{% else %}Index{% endif %}</p>
        <h2>{% if zh %}作品總覽{% else %}FULL INDEX OF WORK{% endif %}</h2>
      </div>

      <div class="work-table">
        <div class="work-table-row work-table-row--head">
          <span>{% if zh %}作品{% else %}PROJECT{% endif %}</span>
          <span>{% if zh %}類型{% else %}TYPE{% endif %}</span>
          <span>{% if zh %}角色{% else %}ROLE{% endif %}</span>
          <span>{% if zh %}年份{% else %}YEAR{% endif %}</span>
        </div>
        <a class="work-table-row work-table-link" href="{{ L }}/work/gate-mg.html" data-spa-target="work/gate-mg"><span>01</span><span>{% if zh %}Gate.com 動態設計{% else %}Gate.com Motion Graphics{% endif %}</span><span>Motion
            Graphics</span><span>2025</span><span class="work-table-icon" aria-hidden="true">↗</span></a>
        <a class="work-table-row work-table-link" href="{{ L }}/work/gate-redbull.html" data-spa-target="work/gate-redbull"><span>02</span><span>{% if zh %}Gate × RedBull F1 NFT{% else %}Gate X RedBull Racing F1 NFT Page{% endif %}</span><span>Web3 /
            Campaign</span><span>2025</span><span class="work-table-icon" aria-hidden="true">↗</span></a>
        <a class="work-table-row work-table-link" href="https://www.behance.net/gallery/203514683/Video-Showreel" target="_blank" rel="noopener noreferrer"><span>03</span><span>Xian-Hao Harry Liao Showreel</span><span>Motion
            / Showreel</span><span>2024</span><span class="work-table-icon" aria-hidden="true">↗</span></a>
        <a class="work-table-row work-table-link" href="{{ L }}/work/thesisbook.html" data-spa-target="work/thesisbook"><span>04</span><span>{% if zh %}Dream Reality 論文書{% else %}MFA Thesis Book : Dream Reality{% endif %}</span><span>Publication
            / Thesis</span><span>2024</span><span class="work-table-icon" aria-hidden="true">↗</span></a>
        <a class="work-table-row work-table-link" href="https://www.behance.net/gallery/200281777/Her-Way-Home-Recital-Visual" target="_blank" rel="noopener noreferrer"><span>05</span><span>{% if zh %}Her Way Home｜演出視覺{% else %}Her Way Home | Recital Visual{% endif %}</span><span>Motion /
            Recital</span><span>2024</span><span class="work-table-icon" aria-hidden="true">↗</span></a>
        <a class="work-table-row work-table-link" href="{{ L }}/work/cocook-app.html" data-spa-target="work/cocook-app"><span>06</span><span>{% if zh %}Cocook App 設計{% else %}Cocook App Design{% endif %}</span><span>App
            Design</span><span>2023</span><span class="work-table-icon" aria-hidden="true">↗</span></a>
        <a class="work-table-row work-table-link" href="{{ L }}/work/DMI.html" data-spa-target="work/DMI"><span>07</span><span>{% if zh %}DMI 網站重新設計{% else %}DMI Website Redesign{% endif %}</span><span>Website
            Redesign</span><span>2023</span><span class="work-table-icon" aria-hidden="true">↗</span></a>
        <a class="work-table-row work-table-link" href="{{ L }}/work/ARCCSRL-Robotic-Limb.html" data-spa-target="work/ARCCSRL-Robotic-Limb"><span>08</span><span>{% if zh %}ARCCSRL 義肢研究{% else %}ARCCSRL Robotic Limb
            Project{% endif %}</span><span>Research / Robotics</span><span>2023</span><span class="work-table-icon" aria-hidden="true">↗</span></a>
        <a class="work-table-row work-table-link" href="{{ L }}/work/bjs-intern.html" data-spa-target="work/bjs-intern"><span>09</span><span>{% if zh %}BJ's 暑期實習秀片{% else %}BJ's Wholesale Club Summer Internship
            Showreel{% endif %}</span><span>Internship / Brand</span><span>2023</span><span class="work-table-icon" aria-hidden="true">↗</span></a>
        <a class="work-table-row work-table-link" href="{{ L }}/work/ABC-Design.html" data-spa-target="work/ABC-Design"><span>10</span><span>{% if zh %}ABC DESIGN 社群視覺{% else %}ABC DESIGN | Social Media Visual{% endif %}</span><span>Social
            Visual</span><span>2022</span><span class="work-table-icon" aria-hidden="true">↗</span></a>
        <a class="work-table-row work-table-link" href="https://www.behance.net/gallery/200283303/Osann-Promo-Video" target="_blank" rel="noopener noreferrer"><span>11</span><span>{% if zh %}Osann 形象影片{% else %}Osann Promo Video{% endif %}</span><span>Promo /
            Video</span><span>2021</span><span class="work-table-icon" aria-hidden="true">↗</span></a>
        <a class="work-table-row work-table-link" href="{{ L }}/work/c-cube.html" data-spa-target="work/c-cube"><span>12</span><span>{% if zh %}C-Cube 網站設計{% else %}C-Cube Website Design{% endif %}</span><span>Website
            Design</span><span>2020</span><span class="work-table-icon" aria-hidden="true">↗</span></a>
        <a class="work-table-row work-table-link" href="{{ L }}/work/for-u.html" data-spa-target="work/for-u"><span>13</span><span>{% if zh %}Reno Gordon - “For-U” MV{% else %}Reno Gordon - "For-U" M/V{% endif %}</span><span>Motion / Music
            Video</span><span>2019</span><span class="work-table-icon" aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="learn-more-section">
      <div class="learn-more-inner">
        <h2 class="learn-more-title">{% if zh %}聯絡 廖先皓 Harry{% else %}Contact Harry{% endif %}</h2>
        <a href="{{ L }}/#contact" class="learn-more-btn" data-spa-target="contact">
          <span>{% if zh %}點這邊{% else %}Click Here{% endif %}</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

  </div>
</div>
